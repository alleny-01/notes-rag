{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/process-pdf.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": [
        "node_modules/pdfjs-dist/{standard_fonts,cmaps}/**",
        "node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs",
        "node_modules/@napi-rs/canvas-linux-x64-gnu/**"
      ]
    }
  }
}
