{
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/process-pdf.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/{pdfjs-dist/standard_fonts/**,pdfjs-dist/cmaps/**,pdfjs-dist/legacy/build/pdf.worker.mjs,@napi-rs/canvas-linux-x64-gnu/**}"
    }
  }
}
